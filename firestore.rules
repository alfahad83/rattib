rules_version = '2';
// قواعد أمان Firestore لتطبيق رتّب
// انسخها في: Firebase Console ← Firestore Database ← Rules ← Publish
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function realAccount() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function ownsShop(shopId) {
      return signedIn() && get(/databases/$(database)/documents/shops/$(shopId)).data.ownerUid == request.auth.uid;
    }

    // المحلات: الكل يشوفها، وصاحب المحل فقط يعدّل محله
    match /shops/{shopId} {
      allow read: if true;
      allow create: if realAccount() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if realAccount() && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if realAccount() && resource.data.ownerUid == request.auth.uid;
    }

    // عدّاد المواعيد المحجوزة لكل ساعة (بدون أسماء العملاء)
    match /slots/{slotId} {
      allow read: if true;
      allow write: if signedIn()
                   && request.resource.data.count is int
                   && request.resource.data.count >= 0;
    }

    // الحجوزات: العميل يشوف حجوزاته، وصاحب المحل يشوف حجوزات محله
    match /bookings/{bookingId} {
      allow create: if signedIn() && request.resource.data.customerUid == request.auth.uid;
      allow read: if signedIn() && (resource.data.customerUid == request.auth.uid || ownsShop(resource.data.shopId));
      allow update: if signedIn()
                    && (resource.data.customerUid == request.auth.uid || ownsShop(resource.data.shopId))
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }
  }
}
